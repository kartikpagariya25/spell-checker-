{
  "name": "spell-checker",
  "version": "0.4.2",
  "description": "Browser extension that silently auto-corrects spelling mistakes as you type. Backspace keeps your original spelling.",
  "private": true,
  "license": "MIT",
  "author": "Kartik Pagariya",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build:dict": "node scripts/build-dictionary.js",
    "build:icons": "node scripts/make-icons.js",
    "check": "node scripts/check.js",
    "pack": "node scripts/check.js && node scripts/pack.js",
    "zip": "node scripts/check.js && node scripts/pack.js --zip"
  }
}
